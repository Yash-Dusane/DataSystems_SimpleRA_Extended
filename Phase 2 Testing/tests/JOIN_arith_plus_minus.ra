SETBUFFER 10
LOAD P2_JOIN_A
LOAD P2_JOIN_B
JP <- JOIN P2_JOIN_A, P2_JOIN_B ON P2_JOIN_A.Aval + P2_JOIN_B.Bval == 10 PROJECT P2_JOIN_A.Aid, P2_JOIN_A.Aval, P2_JOIN_B.Bid, P2_JOIN_B.Bval;
PRINT JP
JM <- JOIN P2_JOIN_A, P2_JOIN_B ON P2_JOIN_A.Aval - P2_JOIN_B.Bval == 2 PROJECT P2_JOIN_A.Aid, P2_JOIN_A.Aval, P2_JOIN_B.Bid, P2_JOIN_B.Bval;
PRINT JM
QUIT
