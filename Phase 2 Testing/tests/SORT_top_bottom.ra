SETBUFFER 10
LOAD P2_SORT_STABLE
SORT P2_SORT_STABLE BY K, S IN ASC, ASC TOP 4 BOTTOM 3
PRINT P2_SORT_STABLE
SORT P2_SORT_STABLE BY K, S IN ASC, ASC TOP 0
PRINT P2_SORT_STABLE
SORT P2_SORT_STABLE BY K, S IN ASC, ASC TOP 4
PRINT P2_SORT_STABLE
SORT P2_SORT_STABLE BY K, S IN ASC, ASC BOTTOM 3
PRINT P2_SORT_STABLE
QUIT
