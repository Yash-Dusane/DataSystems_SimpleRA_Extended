SETBUFFER 10
LOAD EMPLOYEE
R <- GROUP BY Nope FROM EMPLOYEE HAVING AVG(Salary) > 1 RETURN COUNT(*);
R <- GROUP BY Dno FROM EMPLOYEE HAVING AVG(Nope) > 1 RETURN COUNT(*);
R <- GROUP BY Dno FROM EMPLOYEE HAVING AVG(Salary) > 1 RETURN SUM(Nope);
R <- GROUP BY Dno FROM NOPE HAVING AVG(Salary) > 1 RETURN COUNT(*);
QUIT
