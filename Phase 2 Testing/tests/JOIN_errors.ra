SETBUFFER 10
LOAD P2_JOIN_A
LOAD P2_JOIN_B
X <- JOIN NOPE, P2_JOIN_B ON NOPE.Akey == P2_JOIN_B.Bkey;
Y <- JOIN P2_JOIN_A, P2_JOIN_B ON P2_JOIN_A.NO_COL == P2_JOIN_B.Bkey;
Z <- JOIN P2_JOIN_A, P2_JOIN_B ON P2_JOIN_A.Akey == P2_JOIN_B.Bkey WHERE P2_JOIN_B.Bval > 0 PROJECT P2_JOIN_A.Aid;
W <- JOIN P2_JOIN_A, P2_JOIN_B ON Akey == Bkey;
QUIT
